# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# Local example:
MONGODB_URI=mongodb://localhost:27017/syncspace
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/syncspace?retryWrites=true&w=majority
